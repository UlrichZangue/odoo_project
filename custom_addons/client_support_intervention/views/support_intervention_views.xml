<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_support_intervention_tree" model="ir.ui.view"><field name="name">client.support.intervention.tree</field><field name="model">client.support.intervention</field><field name="arch" type="xml"><tree decoration-success="state == 'done'" decoration-muted="state == 'cancelled'"><field name="name"/><field name="ticket_id"/><field name="partner_id"/><field name="user_id"/><field name="planned_date"/><field name="intervention_type"/><field name="state" widget="badge"/></tree></field></record>
  <record id="view_support_intervention_form" model="ir.ui.view"><field name="name">client.support.intervention.form</field><field name="model">client.support.intervention</field><field name="arch" type="xml"><form string="Intervention">
    <header><button name="action_start" type="object" string="Démarrer" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'planned')]}"/><button name="action_done" type="object" string="Terminer" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'in_progress')]}"/><button name="action_validate_client" type="object" string="Valider par le client" attrs="{'invisible': ['|', ('state', '!=', 'done'), ('validation_date', '!=', False)]}"/><button name="action_cancel" type="object" string="Annuler" attrs="{'invisible': [('state', 'in', ['done','cancelled'])]}"/><field name="state" widget="statusbar" statusbar_visible="planned,in_progress,done,cancelled"/></header>
    <sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group><field name="ticket_id"/><field name="partner_id"/><field name="user_id"/><field name="intervention_type"/></group><group><field name="planned_date"/><field name="start_date"/><field name="end_date"/></group></group>
    <notebook><page string="Compte rendu"><group><field name="diagnostic"/><field name="actions_done"/><field name="result"/></group></page><page string="Validation client"><group><field name="client_validation"/><field name="validation_date"/></group></page></notebook></sheet>
    <div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div></form></field></record>
  <record id="view_support_intervention_search" model="ir.ui.view"><field name="name">client.support.intervention.search</field><field name="model">client.support.intervention</field><field name="arch" type="xml"><search><field name="name"/><field name="ticket_id"/><field name="partner_id"/><field name="user_id"/><filter name="my_interventions" string="Mes interventions" domain="[('user_id', '=', uid)]"/><filter name="planned" string="Planifiées" domain="[('state', '=', 'planned')]"/><separator/><filter name="group_state" string="Statut" context="{'group_by': 'state'}"/><filter name="group_user" string="Consultant" context="{'group_by': 'user_id'}"/><filter name="group_partner" string="Client" context="{'group_by': 'partner_id'}"/></search></field></record>
  <record id="action_support_intervention" model="ir.actions.act_window"><field name="name">Interventions</field><field name="res_model">client.support.intervention</field><field name="view_mode">tree,form</field><field name="search_view_id" ref="view_support_intervention_search"/></record>
</odoo>

