<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_support_ticket_tree" model="ir.ui.view">
    <field name="name">client.support.ticket.tree</field><field name="model">client.support.ticket</field>
    <field name="arch" type="xml"><tree decoration-danger="priority == '3'" decoration-success="state == 'resolved'" decoration-muted="state == 'closed'">
      <field name="name"/><field name="title"/><field name="partner_id"/><field name="user_id"/><field name="category_id"/>
      <field name="priority" widget="priority"/><field name="deadline"/><field name="state" widget="badge"/>
    </tree></field>
  </record>
  <record id="view_support_ticket_form" model="ir.ui.view">
    <field name="name">client.support.ticket.form</field><field name="model">client.support.ticket</field>
    <field name="arch" type="xml"><form string="Ticket de support">
      <header>
        <button name="action_assign" type="object" string="Assigner" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'new')]}"/>
        <button name="action_start" type="object" string="Démarrer" class="oe_highlight" attrs="{'invisible': [('state', 'not in', ['assigned','waiting'])]}"/>
        <button name="action_wait" type="object" string="Mettre en attente" attrs="{'invisible': [('state', '!=', 'in_progress')]}"/>
        <button name="action_resolve" type="object" string="Résoudre" class="oe_highlight" attrs="{'invisible': [('state', 'not in', ['in_progress','waiting'])]}"/>
        <button name="action_close" type="object" string="Fermer" attrs="{'invisible': [('state', '!=', 'resolved')]}"/>
        <button name="action_reopen" type="object" string="Rouvrir" attrs="{'invisible': [('state', 'not in', ['resolved','closed'])]}"/>
        <field name="state" widget="statusbar" statusbar_visible="new,assigned,in_progress,waiting,resolved,closed"/>
      </header><sheet>
        <div class="oe_button_box" name="button_box"><button name="action_view_interventions" type="object" class="oe_stat_button" icon="fa-wrench"><field name="intervention_count" widget="statinfo" string="Interventions"/></button></div>
        <div class="oe_title"><label for="name"/><h1><field name="name"/></h1><h2><field name="title" placeholder="Résumé du besoin client"/></h2></div>
        <group><group><field name="partner_id"/><field name="contact_id" context="{'default_parent_id': partner_id}"/><field name="category_id"/></group>
        <group><field name="user_id"/><field name="priority" widget="priority"/><field name="deadline"/><field name="resolved_date" attrs="{'invisible': [('resolved_date', '=', False)]}"/></group></group>
        <notebook><page string="Description"><field name="description" placeholder="Contexte, impact et symptômes observés…"/></page>
        <page string="Interventions"><field name="intervention_ids" context="{'default_ticket_id': active_id}"><tree editable="bottom"><field name="name"/><field name="planned_date"/><field name="user_id"/><field name="intervention_type"/><field name="state" widget="badge"/></tree></field></page></notebook>
      </sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div>
    </form></field>
  </record>
  <record id="view_support_ticket_search" model="ir.ui.view">
    <field name="name">client.support.ticket.search</field><field name="model">client.support.ticket</field>
    <field name="arch" type="xml"><search string="Rechercher des tickets"><field name="name"/><field name="title"/><field name="partner_id"/><field name="user_id"/><field name="category_id"/>
      <filter name="my_tickets" string="Mes tickets" domain="[('user_id', '=', uid)]"/>
      <filter name="urgent" string="Urgents" domain="[('priority', '=', '3')]"/>
      <filter name="open" string="Ouverts" domain="[('state', 'not in', ['resolved','closed'])]"/>
      <separator/><filter name="group_state" string="État" context="{'group_by': 'state'}"/><filter name="group_priority" string="Priorité" context="{'group_by': 'priority'}"/>
      <filter name="group_user" string="Consultant" context="{'group_by': 'user_id'}"/><filter name="group_partner" string="Client" context="{'group_by': 'partner_id'}"/><filter name="group_category" string="Catégorie" context="{'group_by': 'category_id'}"/>
    </search></field>
  </record>
  <record id="view_support_ticket_kanban" model="ir.ui.view">
    <field name="name">client.support.ticket.kanban</field><field name="model">client.support.ticket</field>
    <field name="arch" type="xml"><kanban default_group_by="state" class="o_kanban_small_column"><field name="priority"/><field name="state"/><field name="partner_id"/><field name="user_id"/><field name="deadline"/>
      <templates><t t-name="kanban-box"><div t-attf-class="oe_kanban_card oe_kanban_global_click {{ record.priority.raw_value == '3' ? 'border-danger' : '' }}">
        <div class="o_kanban_record_top"><strong><field name="name"/> — <field name="title"/></strong><field name="priority" widget="priority"/></div>
        <div><i class="fa fa-building-o" title="Client"/> <field name="partner_id"/></div><div><i class="fa fa-user" title="Consultant"/> <field name="user_id"/></div>
        <div t-if="record.deadline.raw_value"><i class="fa fa-clock-o" title="Échéance"/> <field name="deadline"/></div>
      </div></t></templates>
    </kanban></field>
  </record>
  <record id="action_support_ticket" model="ir.actions.act_window"><field name="name">Tickets</field><field name="res_model">client.support.ticket</field><field name="view_mode">kanban,tree,form</field><field name="search_view_id" ref="view_support_ticket_search"/><field name="context">{'search_default_open': 1}</field></record>
</odoo>
